# ExoSphere Environment Configuration
# Copy this file to .env and modify as needed

# Database
# SQLite (development)
DATABASE_URL=sqlite:///./exosphere.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/exosphere

# API Server
EXOSPHERE_HOST=0.0.0.0
EXOSPHERE_PORT=8000
EXOSPHERE_WORKERS=1

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Background Jobs
MAX_CONCURRENT_JOBS=1
JOB_POLL_INTERVAL=5.0

# Retrieval Defaults
DEFAULT_N_LIVE=500
DEFAULT_DLOGZ=0.01
MAX_ITER=50000

# File Storage
DATA_CACHE_DIR=data_cache
SPECTRA_STORE_DIR=data_cache/store